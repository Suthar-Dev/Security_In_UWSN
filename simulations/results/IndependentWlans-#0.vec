version 3
run IndependentWlans-0-20240930-02:19:25-20616
attr configname IndependentWlans
attr datetime 20240930-02:19:25
attr datetimef 20240930-021925
attr experiment IndependentWlans
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network Network
attr processid 20616
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../../inet4.5/images
config description "Two independent WLANs on different radio channels"
config *.useEthernetSwitching false
config *.useRouting false
config network Network
config sim-time-limit 400s
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 500m
config **.constraintAreaMaxY 300m
config **.constraintAreaMaxZ 0m
config *.*.mobility.typename StationaryMobility
config *.wirelessHost.mobility.initialX 50m
config *.wirelessHost.mobility.initialY 100m
config *.accessPoint1.mobility.initialX 150m
config *.accessPoint1.mobility.initialY 250m
config **.analogModel.ignorePartialInterference true
config *.accessPoint1.wlan[0].address "\"001111111111\""
config *.accessPoint1.wlan[0].mgmt.ssid "\"alpha\""
config *.accessPoint1.wlan[0].radio.channelNumber 0
config *.wirelessHost.wlan[0].mgmt.accessPointAddress "\"001111111111\""
config *.wirelessHost.wlan[0].radio.channelNumber 0
config *.wirelessHost1.wlan[0].mgmt.accessPointAddress "\"001111111111\""
config *.host2.wlan[0].radio.channelNumber 0
config *.host*.**.mgmt.typename Ieee80211MgmtStaSimplified
config *.host*.**.agent.typename ""
config *.accessPoint*.**.mgmt.typename Ieee80211MgmtApSimplified
config **.wlan*.bitrate 11Mbps
config **.host*.numApps 2
config **.app[0].typename PingApp
config *.sensorNode.app[0].destAddr "\"wirelessHost\""
config **.app[1].typename PingApp
config *.wirelessHost.app[1].destAddr "\"wirelessHost1\""
config **.printPing true
config *.useEthernetSwitching false
config *.useRouting true
config *.configurator.config "xmldoc(\"network.xml\")"

vector 0 Network.accessPoint1.wlan[0].mac.dcf frameSequenceActive:vector ETV
attr autoWarmupFilter false
attr interpolationmode sample-hold
attr recordingmode vector
attr source warmup(count(frameSequenceStarted)-count(frameSequenceFinished))
attr title "frame sequence active"
vector 1 Network.accessPoint1.wlan[0].mac.dcf.channelAccess.pendingQueue queueLength:vector ETV
attr autoWarmupFilter false
attr interpolationmode sample-hold
attr recordingmode vector
attr source "warmup(atomic(constant0(packetPushEnded) + count(packetPushStarted) - count(packetPulled) - count(packetRemoved) - count(packetDropped)))"
attr title "queue length"
attr unit pk
vector 2 Network.accessPoint1.wlan[0].mac.dcf.channelAccess.pendingQueue queueBitLength:vector ETV
